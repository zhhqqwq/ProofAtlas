{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhhqqwq/ProofAtlas/schema/cognitive-proof-graph/v1/cognitive-proof-graph.schema.json",
  "title": "ProofAtlas Cognitive Proof Graph v1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","graph","entities","scopes","relations","mentions","relation_signatures","presentation_sequences","validation_invariants"],
  "properties": {
    "schema_version": {"const":"1.0-rc1"},
    "graph": {
      "type":"object","additionalProperties":false,
      "required":["id","title","status","root_scope"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "title":{"type":"string","minLength":1},
        "status":{"enum":["draft","validated","invalid"]},
        "root_scope":{"type":"string","minLength":1},
        "source":{"type":["string","null"]},
        "description":{"type":["string","null"]},
        "metadata":{"type":"object"}
      }
    },
    "entities":{"type":"array","items":{"$ref":"#/$defs/entity"}},
    "scopes":{"type":"array","items":{"$ref":"#/$defs/scope"}},
    "relations":{"type":"array","items":{"$ref":"#/$defs/relation"}},
    "mentions":{"type":"array","items":{"$ref":"#/$defs/mention"}},
    "relation_signatures":{
      "type":"object","required":["catalog_version"],"additionalProperties":false,
      "properties":{"catalog_version":{"const":"1.0-rc1"},"catalog_path":{"type":"string"}}
    },
    "presentation_sequences":{"type":"array","items":{"$ref":"#/$defs/presentationSequence"}},
    "validation_invariants":{"type":"array","minItems":1,"items":{"type":"string"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "entity":{
      "type":"object","additionalProperties":false,
      "required":["id","kind","home_scope","canonical_label"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "kind":{"enum":["MathematicalEntity","Claim","Route","Episode","Unit","ConstructionPolicy","SearchSpace","Theorem","PresentationSpan"]},
        "home_scope":{"$ref":"#/$defs/id"},
        "canonical_label":{"type":"string","minLength":1},
        "aliases":{"type":"array","items":{"type":"string"},"default":[]},
        "math_kind_hint":{"type":["string","null"]},
        "proposition_text":{"type":["string","null"]},
        "references":{"type":"array","items":{"$ref":"#/$defs/id"},"default":[]},
        "claim_status":{"enum":["given","assumed","goal","required","candidate_requirement","proved","disproved","discharged","contradiction_target","returned_guarantee",null]},
        "process_status":{"enum":["active","completed","abandoned","suspended","returned",null]},
        "process_profile":{"type":"object"},
        "knowledge_profile":{"type":"object"},
        "presentation_profile":{"type":"object"},
        "created_by":{"type":["string","null"]},
        "origin_mode":{"enum":["chosen","derived","existential_witness","theorem_supplied","inherited","normalized",null]},
        "confidence":{"enum":["certain","strong","plausible","ambiguous","speculative",null]},
        "metadata":{"type":"object"}
      },
      "allOf":[
        {"if":{"properties":{"kind":{"const":"Claim"}}},"then":{"required":["proposition_text"]}},
        {"if":{"properties":{"kind":{"const":"PresentationSpan"}}},"then":{"required":["presentation_profile"]}}
      ]
    },
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["id","kind","status"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "kind":{"enum":["proof","route","branch","subproof","policy","local","episode"]},
        "parent_scope":{"type":["string","null"]},
        "status":{"enum":["active","closed","abandoned"]},
        "active_assumptions":{"type":"array","items":{"$ref":"#/$defs/id"},"default":[]},
        "local_bindings":{"type":"array","items":{"$ref":"#/$defs/id"},"default":[]},
        "imports":{"type":"array","items":{"$ref":"#/$defs/id"},"default":[]},
        "exports":{"type":"array","items":{"$ref":"#/$defs/id"},"default":[]},
        "metadata":{"type":"object"}
      }
    },
    "participant":{
      "type":"object","additionalProperties":false,"required":["role","ref"],
      "properties":{"role":{"type":"string","minLength":1},"ref":{"$ref":"#/$defs/id"}}
    },
    "evidence":{
      "type":"object","additionalProperties":false,"required":["kind"],
      "properties":{
        "kind":{"enum":["explicit_text","mathematical_derivation","theorem_instance","constraint_provenance","constant_provenance","m3_forward_reconstruction","structural_reconstruction","pedagogical_reconstruction","source_grounded_history","given_or_inherited"]},
        "detail":{"type":["string","null"]}
      }
    },
    "eventData":{
      "type":"object","additionalProperties":false,
      "properties":{
        "preconditions":{"type":"array","items":{"$ref":"#/$defs/id"}},
        "outputs":{"type":"array","items":{"$ref":"#/$defs/id"}},
        "causal_parents":{"type":"array","items":{"$ref":"#/$defs/id"}},
        "outcome":{"type":["string","null"]},
        "state_delta":{"type":"object"}
      }
    },
    "relation":{
      "type":"object","additionalProperties":false,
      "required":["id","semantic_mode","layer","relation_type","participants","scope","evidence","confidence"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "semantic_mode":{"enum":["assertion","event"]},
        "layer":{"enum":["logical","search","presentation","cross_layer"]},
        "relation_type":{"type":"string","minLength":1},
        "participants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/participant"}},
        "scope":{"$ref":"#/$defs/id"},
        "evidence":{"$ref":"#/$defs/evidence"},
        "confidence":{"enum":["certain","strong","plausible","ambiguous","speculative"]},
        "fidelity":{"type":["string","null"]},
        "event":{"$ref":"#/$defs/eventData"},
        "loss_profile":{"type":"array","items":{"enum":["motivation_loss","alternative_loss","constraint_provenance_loss","constant_provenance_loss","branch_loss","theorem_role_loss","scope_loss","optimization_status_loss","dependency_loss","learner_explanation_loss"]}},
        "metadata":{"type":"object"}
      },
      "allOf":[{"if":{"properties":{"semantic_mode":{"const":"event"}}},"then":{"required":["event"]}}]
    },
    "mention":{
      "type":"object","additionalProperties":false,
      "required":["id","entity_id","scope","view","source_span","surface_form"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "entity_id":{"$ref":"#/$defs/id"},
        "scope":{"$ref":"#/$defs/id"},
        "view":{"enum":["search","logical","presentation","learner"]},
        "source_span":{"$ref":"#/$defs/id"},
        "surface_form":{"type":"string"},
        "role_in_span":{"type":["string","null"]},
        "metadata":{"type":"object"}
      }
    },
    "presentationSequence":{
      "type":"object","additionalProperties":false,
      "required":["id","document_id","ordered_spans"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "document_id":{"type":"string","minLength":1},
        "ordered_spans":{"type":"array","items":{"$ref":"#/$defs/id"}}
      }
    }
  }
}